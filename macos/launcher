#!/bin/bash
# N3 단어 — 단어장을 Chrome 앱 모드(주소창 없는 창)로 띄움
RES="$(cd "$(dirname "$0")/../Resources" && pwd)"
DATA="$HOME/Library/Application Support/N3Words"
LOG="$DATA/launcher.log"
mkdir -p "$DATA/profile"
# 한글·공백 없는 경로로 복사해서 file:// 주소 문제를 피함
cp -f "$RES/index.html" "$DATA/index.html"
URL="file://$(echo "$DATA/index.html" | sed 's/ /%20/g')"

for APP in "Google Chrome" "Microsoft Edge" "Brave Browser"; do
  BIN="/Applications/$APP.app/Contents/MacOS/$APP"
  [ -x "$BIN" ] || BIN="$HOME/Applications/$APP.app/Contents/MacOS/$APP"
  if [ -x "$BIN" ]; then
    echo "$(date) launching $BIN $URL" > "$LOG"
    # 별도 프로필로 바이너리를 직접 실행 → 기존 Chrome 창과 섞이지 않음
    nohup "$BIN" --user-data-dir="$DATA/profile" --app="$URL" \
      --window-size=900,780 --no-first-run --no-default-browser-check \
      --disable-features=ChromeWhatsNewUI >>"$LOG" 2>&1 &
    exit 0
  fi
done
echo "$(date) no chromium browser found; opening default" > "$LOG"
open "$DATA/index.html"
